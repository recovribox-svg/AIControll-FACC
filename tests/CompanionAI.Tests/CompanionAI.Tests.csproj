<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for the game-independent parts of the mod (no game assemblies needed). Run: dotnet test tests/CompanionAI.Tests -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Tactics\SpellTierPolicy.cs" Link="SpellTierPolicy.cs" />
    <Compile Include="..\..\Tactics\ActionRules.cs" Link="ActionRules.cs" />
    <Compile Include="..\..\Tactics\RiskMath.cs" Link="RiskMath.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>
</Project>
